---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				text-align: left;
			}
			.hero h1 {
				margin-bottom: 0.25em;
			}
			.lead {
				font-size: 1.25em;
			}
			.cta {
				display: inline-block;
				margin-top: 1em;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				background: var(--accent);
				color: white;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="lead">
					Truth-Poly is an automated pipeline I built. It watches Donald Trump's Truth Social account,
					works out when a post moves a Polymarket market, and places the trade within 2-3 seconds.
					This blog explains how it works and logs the trades.
				</p>
				<a class="cta" href="/blog">Read the blog</a>
			</section>
		</main>
		<Footer />
	</body>
</html>